# ============================================================
# Duhodah — Apache cache i kompresija
# ============================================================

# Kratke URL adrese (bez .html ekstenzije)
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^hq$           hq.html           [L,R=301]
  RewriteRule ^events-admin$ events-admin.html [L,R=301]
  RewriteRule ^admin$        admin.html        [L,R=301]
</IfModule>

# Uključi kompresiju (Gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache headers za statičke assete
<IfModule mod_expires.c>
  ExpiresActive On

  # Slike — 1 godina (mijenjaju se rijetko)
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/gif   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon  "access plus 1 year"

  # CSS i JS — bez cachea (ETag validacija; ?v= query parametri više nisu potrebni)
  ExpiresByType text/css        "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"

  # Fontovi — 1 godina
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # HTML i JSON — bez cachea (uvijek svježe)
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control header direktno
<IfModule mod_headers.c>
  # Slike
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS i JS — ETag validacija (browser uvijek pita server, bez downloada ako nije promijenjeno)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # HTML — bez cachea
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Zabrani direktni pristup osjetljivim datotekama
<FilesMatch "\.(log|sql|env|json)$">
  <RequireAll>
    Require all denied
  </RequireAll>
</FilesMatch>

# Dopusti pristup supabase-schema.sql samo lokalno (blokira javni pristup)
<Files "supabase-schema.sql">
  Require all denied
</Files>
