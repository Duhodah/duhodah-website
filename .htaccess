# ============================================================
# Duhodah — Apache cache i kompresija
# ============================================================

# Uključi kompresiju (Gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache headers za statičke assete
<IfModule mod_expires.c>
  ExpiresActive On

  # Slike — 1 godina (mijenjaju se rijetko)
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/gif   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon  "access plus 1 year"

  # CSS i JS — 1 tjedan (busted verzijom ?v=x kad se mijenja)
  ExpiresByType text/css        "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # Fontovi — 1 godina
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # HTML i JSON — bez cachea (uvijek svježe)
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control header direktno
<IfModule mod_headers.c>
  # Slike
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CSS i JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML — bez cachea
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Zabrani direktni pristup osjetljivim datotekama
<FilesMatch "\.(log|sql|env|json)$">
  <RequireAll>
    Require all denied
  </RequireAll>
</FilesMatch>

# Dopusti pristup supabase-schema.sql samo lokalno (blokira javni pristup)
<Files "supabase-schema.sql">
  Require all denied
</Files>
